{
	"name": "xpaw/steamid",
	"description": "SteamID conversion library",
	"minimum-stability": "stable",
	"license": "MIT",
	"authors":
	[
		{
			"name": "Pavel Djundik",
			"email": "steamid.php@xpaw.me"
		}
	],
	"funding":
	[
        {
            "type": "github",
            "url": "https://github.com/sponsors/xPaw"
        }
	],
	"require":
	{
		"php": ">=8.5",
		"ext-gmp": "*"
	},
	"require-dev":
	{
		"phpunit/phpunit": "^13.0",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-strict-rules": "^2.0"
	},
	"scripts":
	{
		"test": "phpunit --configuration .phpunit.xml --fail-on-warning",
		"phpstan": "phpstan analyse"
	},
	"autoload":
	{
		"psr-4":
		{
			"xPaw\\Steam\\": "src/"
		}
	},
	"archive":
	{
		"exclude":
		[
			"/.gitattributes",
			"/.phpunit.xml",
			"/coverage.xml",
			"/Example.php",
			"/phpstan.neon",
			"/VanityURLs.php",
			"/vendor"
		]
	}
}
